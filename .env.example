# نمونه فایل تنظیمات. نسخه واقعی روی سرور در /opt/divar/.env است.
# توکن ربات تلگرام (از BotFather بگیرید و توکن قدیمی را با /revoke باطل کنید)
TELEGRAM_BOT_TOKEN=

# رمز ورود به پنل (اجباری). رمز قوی بگذارید.
PANEL_PASSWORD=

# کلید امضای کوکی نشست؛ اگر خالی باشد از رمز ساخته می‌شود، بهتر است مقدار تصادفی بگذارید.
PANEL_SECRET=

# محل ذخیره دیتابیس
DIVAR_DATA_DIR=/opt/divar/data

# اجرای نخ پس‌زمینه ربات همراه پنل (۱ = روشن)
DIVAR_WORKER=1

# کوکی فقط روی HTTPS فرستاده شود (اگر بدون TLS تست می‌کنید ۰ بگذارید)
PANEL_COOKIE_SECURE=1
